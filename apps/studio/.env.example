# Copy to .env (same folder) and fill in. Never commit .env.

# Real agent: an API key from https://console.anthropic.com (Settings → API keys).
# You can also paste it on the studio home screen the first time; it is saved here.
ANTHROPIC_API_KEY=

# Optional
# STUDIO_MODEL=claude-opus-5-5
# STUDIO_PORT=4100
# STUDIO_INTAKE_TOKEN=               # require "Authorization: Bearer <token>" on POST /api/intake
# STUDIO_PROTOTYPE_ORIGIN=http://127.0.0.1:3001
# STUDIO_DEMO_SITE_URL=https://design-request-app-one.vercel.app/
# STUDIO_REPO_ROOT=../..             # the design repo root (defaults to two folders up)
# STUDIO_HOST=127.0.0.1              # who can open the studio: 127.0.0.1 = this computer only (default). 0.0.0.0 = your network (everyone still signs in)
# STUDIO_SECURE_COOKIE=1             # set when the studio is served over https
# STUDIO_LANE_AUTOSTART=0            # don't start the prototype lane automatically

# Research folder in Figma (read-only personal access token: Figma → Settings → Security → Personal access tokens,
# scopes "Folders: read" + "File content: read"). Lets the studio see new/updated research files every 6 hours.
# FIGMA_TOKEN=
# STUDIO_FIGMA_FILE=MYeELetKW9xye1shSpm8Fn  # the only Figma file the agent may write to (Design Agent file)
