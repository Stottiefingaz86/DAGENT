# Design Studio server settings. Copy to /etc/design-studio/studio.env (chmod 600), or load the secrets
# from AWS Secrets Manager / SSM Parameter Store into the same names. Never commit the real file.

# --- Secrets ---
ANTHROPIC_API_KEY=            # company Anthropic API key (the agent's runs are billed here)
FIGMA_TOKEN=                  # read-only Figma token for the research folder (Settings → Figma research folder)
GITHUB_TOKEN=                 # fine-grained token: ft-unified-platform/DesignAgent, Contents read + write
STUDIO_INTAKE_TOKEN=          # optional: lets other systems send BRDs to /api/intake (Bearer token)

# --- Addresses (behind the load balancer, HTTPS) ---
STUDIO_PUBLIC_URL=https://studio.example.com
STUDIO_PROTOTYPE_PUBLIC_URL=https://proto.example.com
STUDIO_COOKIE_DOMAIN=.example.com   # shares the login with the prototype address

# --- Repo ---
STUDIO_GIT_URL=https://github.com/ft-unified-platform/DesignAgent.git
STUDIO_GIT_BASE_BRANCH=main
STUDIO_GIT_SYNC_BRANCH=studio-work  # the agent's work is pushed here; merge to main with a pull request
STUDIO_GIT_SYNC_MINUTES=15
STUDIO_GIT_NAME=Design Studio
STUDIO_GIT_EMAIL=design-studio@users.noreply.github.com

# --- Set by the image (change only if you know why) ---
# STUDIO_HOST=0.0.0.0  STUDIO_PORT=4100  STUDIO_PROTOTYPE_PROXY_PORT=4101  STUDIO_TRUST_PROXY=1
# STUDIO_SECURE_COOKIE=1  STUDIO_KEY_SOURCE=env  STUDIO_CHROME_PATH=/usr/bin/chromium  CLAUDE_CONFIG_DIR=/data/claude
